    "name": "Smart Energy Monitoring System",
    "description": "REST API Collection for Smart Energy Monitoring System (Device ID: SEM-ESP32-001).\nAll units use apparent energy terminology (V, A, VA, VAh, kVAh).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Ingest Telemetry (POST /api/v1/measurements)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"SEM-ESP32-001\",\n  \"voltageRms\": 231.20,\n  \"currentRms\": 5.450,\n  \"samplingDurationSeconds\": 1.00\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/measurements",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "measurements"]
        },
        "description": "Simulates an ESP32 edge device transmitting instantaneous electrical telemetry. Apparent power and incremental energy are automatically computed."
      }
    },
    {
      "name": "2. Get Latest Telemetry (GET /api/v1/measurements/latest)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/measurements/latest?deviceId=SEM-ESP32-001",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "measurements", "latest"],
          "query": [
            {
              "key": "deviceId",
              "value": "SEM-ESP32-001"
            }
          ]
        },
        "description": "Retrieves the single most recent instantaneous electrical telemetry sample for the specified hardware device."
      }
    },
    {
      "name": "3. Get Telemetry History (GET /api/v1/measurements/history)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/measurements/history?deviceId=SEM-ESP32-001",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "measurements", "history"],
          "query": [
            {
              "key": "deviceId",
              "value": "SEM-ESP32-001"
            }
          ]
        },
        "description": "Retrieves historical time-series telemetry for charting and graph rendering. Defaults to the last 24 hours."
      }
    },
    {
